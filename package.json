{
  "name": "imposter-dixit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Dixit-style card game with a hidden imposter, for playing with friends.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "bot": "node bots/bot.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
